+    // Reseed every random source a single-note render uses (oscillator start phases, drift, noise,
+    // S&H / String oscillators via std::rand, Twist via stmlib, the per-note random modulators), so two renders of
+    // the same patch with the same seed are identical. Call after loading, before playNote.
+    void seedRandom(uint32_t seed)
+    {
+        storage.rngGen.g.seed(seed);
+        storage.noiseRng.reseed(seed + 1);
+        std::srand(seed + 2);
+        stmlib::Random::Seed(seed + 9); // Twist oscillator (Plaits engines)
+        time_data.ppqPos = 0; // tempo-synced / free-running LFOs follow the song position
+        for (int sc = 0; sc < n_scenes; ++sc)
+        {
+            // scene LFOs live as long as the synth (voice LFOs are created per note)
+            for (int l = 0; l < n_lfos_scene; ++l)
+                if (auto *lfo = dynamic_cast<LFOModulationSource *>(
+                        storage.getPatch().scene[sc].modsources[ms_slfo1 + l]))
+                    lfo->reseedRandom(seed + 20 + 16 * sc + l);
+            for (int id : {ms_random_bipolar, ms_random_unipolar})
+                if (auto *r = dynamic_cast<RandomModulationSource *>(
+                        storage.getPatch().scene[sc].modsources[id]))
+                    r->gen.seed(seed + 3 + 2 * sc + (id == ms_random_unipolar));
+        }
+    }
+
+    int getParamCtrlType(const SurgePyNamedParam &id) { return paramPtr(id)->ctrltype; }
+
+    std::string getParamOSCName(const SurgePyNamedParam &id) { return paramPtr(id)->oscName; }
+
+    std::string getParamStorageName(const SurgePyNamedParam &id)
+    {
+        return paramPtr(id)->get_storage_name();
+    }
+
+    // fx_disable is a bitmask without a ctrltype (range +-2^31); setParamVal's float normalisation
+    // cannot represent it, so it is written directly. The engine reads val.i per audio block.
+    void setFxDisable(int mask) { storage.getPatch().fx_disable.val.i = mask; }
+
+    // temposync / extend / absolute belong to the parameter slot and survive type changes (an FX
+    // type change even restores them from fxsync). bound_value() snaps to the tempo grid whenever
+    // temposync is set, but setTempoSync refuses on a ctrltype that can't sync, so clear directly.
+    void clearParamFlags(const SurgePyNamedParam &id)
+    {
+        auto p = paramPtr(id);
+        p->temposync = false;
+        p->set_extend_range(false);
+        p->absolute = false;
+    }
+
+    std::string getWavetableName(int scene, int osc)
+    {
+        if (scene < 0 || scene >= n_scenes || osc < 0 || osc >= n_oscs)
+            throw std::out_of_range("scene or osc out of range");
+        return storage.getPatch().scene[scene].osc[osc].wavetable_display_name;
+    }
